# Copy to .env and adjust. Real environment variables override this file.

# Django
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Frontend origins allowed to call the API (comma-separated, no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AWS credentials are NOT configured here. The scanner uses named profiles from
# ~/.aws/config and ~/.aws/credentials (pick one in the UI), or the default
# credential chain when no profile is selected.
# Optional: point boto3 at non-default config files.
# AWS_CONFIG_FILE=
# AWS_SHARED_CREDENTIALS_FILE=
